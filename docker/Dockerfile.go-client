# Go Stratum V2 Client Image
# Build libsv2 (Rust) then Go binary linking dynamically.

ARG RUST_VERSION=1.82
FROM rust:${RUST_VERSION} as rust-builder
WORKDIR /app
COPY Cargo.toml Cargo.lock* .
COPY src src
# Needed for cargo to build the local uniffi-bindgen binary
COPY uniffi-bindgen.rs uniffi-bindgen.rs
# Include Go sources to vendor later if needed
COPY go go
RUN cargo build --release

FROM golang:1.22 as go-builder
WORKDIR /app
COPY --from=rust-builder /app/target/release/libsv2.so /usr/lib/libsv2.so
COPY go go
ENV LD_LIBRARY_PATH=/usr/lib
# Build Go client binary
WORKDIR /app/go/examples/client_example
RUN go build -o /app/sv2-go-client .

FROM debian:stable-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=rust-builder /app/target/release/libsv2.so /usr/lib/libsv2.so
COPY --from=go-builder /app/sv2-go-client /usr/local/bin/sv2-go-client
ENV LD_LIBRARY_PATH=/usr/lib
CMD ["sv2-go-client"]
